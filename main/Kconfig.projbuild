menu "mybot"

    config MYBOT_PSRAM_ALLOCATIONS
        bool
        default y
        depends on SPIRAM && (SPIRAM_USE_CAPS_ALLOC || SPIRAM_USE_MALLOC)
        select FREERTOS_TASK_CREATE_ALLOW_EXT_MEM
        select NVS_ALLOCATE_CACHE_IN_SPIRAM
        help
            Platform data and worker stacks use PSRAM. Keep kernel objects,
            hardware DMA buffers and flash-writing task stacks in internal RAM.

    choice MYBOT_LANGUAGE
        prompt "Product language"
        default MYBOT_LANGUAGE_ZH_CN

        config MYBOT_LANGUAGE_ZH_CN
            bool "Chinese (zh-CN)"

        config MYBOT_LANGUAGE_EN_US
            bool "English (en-US)"
    endchoice

    config MYBOT_LANGUAGE_TAG
        string
        default "en-US" if MYBOT_LANGUAGE_EN_US
        default "zh-CN"

    config MYBOT_SERVER_BASE
        string
        default "https://mybot.sh3t.agoralab.co/api"

    config MYBOT_SOURCE_LANGUAGE
        string "Initial source language"
        default "zh-CN"

    config MYBOT_TARGET_LANGUAGE
        string "Initial translated-output language"
        default "en-US"

    choice MYBOT_AUDIO_PTIME
        prompt "Audio packet duration"
        default MYBOT_AUDIO_PTIME_60

        help
            The bundled ESP32-S31 Agora RTSA package uses 60 ms audio frames.
            Other packet durations require a deliberately supplied matching package.

        config MYBOT_AUDIO_PTIME_60
            bool "60 ms"
    endchoice

    config MYBOT_AUDIO_PTIME_MS
        int
        default 60 if MYBOT_AUDIO_PTIME_60

    config MYBOT_CLOUD_AEC
        bool "Enable cloud AEC"
        default y

    config MYBOT_AI_QOS
        bool "Enable Agora AI QoS"
        default n

    config MYBOT_FAST_SEND_MULTIPLIER
        int "Agora fast-send multiplier"
        range 1 5
        default 3

    config MYBOT_DEBUG_RESOURCE_MONITOR
        bool "Enable debug CPU and memory monitor"
        default n
        depends on !FREERTOS_SMP
        select FREERTOS_GENERATE_RUN_TIME_STATS
        help
            Log per-core busy time estimated from idle runtime deltas and heap
            statistics using a low-priority task. Adds scheduler accounting and
            serial logging overhead; intended for diagnostics only.

    config MYBOT_USB_CDC_PROBE
        bool "Enable native USB CDC loopback probe (diagnostic)"
        default n
        depends on IDF_TARGET_ESP32S31
        select TINYUSB_CDC_ENABLED
        select TINYUSB_SUSPEND_CALLBACK
        select TINYUSB_RESUME_CALLBACK
        help
            Enumerate J2's native USB controller as a CDC device and echo raw
            bytes for link verification. UART remains the log/flash console.
            This diagnostic boot does not start NVS, network, display, audio
            or translation. The probe tasks continue after app_main returns.
            This does not implement USB audio or control J2's hardwired 5 V
            VBUS output. Board/cable power and host-role requirements remain
            independent of this firmware diagnostic.

    config MYBOT_USB_HOST_PROBE
        bool "Enable native USB Host enumeration probe (diagnostic only)"
        default n
        depends on IDF_TARGET_ESP32S31 && !MYBOT_USB_CDC_PROBE
        help
            Use J2 as USB Host to enumerate an attached device and print its
            descriptors. This boot runs only the USB probe and UART logging;
            translation, Wi-Fi, display and audio do not start. No storage,
            MTP or ADB class driver is installed. Use a USB peripheral such
            as an Android phone, not another computer, on J2.

    config MYBOT_ENABLE_VIDEO
        bool
        default n
        help
            Video is intentionally unavailable in the S31 first release.

    config MYBOT_DEBUG_RESOURCE_MONITOR_INTERVAL_MS
        int "Resource monitor interval (ms)"
        depends on MYBOT_DEBUG_RESOURCE_MONITOR
        range 1000 60000
        default 5000

endmenu
