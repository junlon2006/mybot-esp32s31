# SPDX-License-Identifier: Apache-2.0
# Standalone V1.2 diagnostic: no business stack, storage writes, display or network.
CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="diagnostics/mosaico_uac/partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
# CONFIG_SPIRAM is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_GPIO=58
CONFIG_ESP_CONSOLE_UART_RX_GPIO=59
CONFIG_CODEC_ES8311_SUPPORT=y
# CONFIG_CODEC_ES8389_SUPPORT is not set
# CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE is not set
# CONFIG_USB_DEVICE_UAC_AS_PART is not set
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_UAC_TUSB_PRODUCT="Mosaico UAC Test"
CONFIG_UAC_TUSB_MANUFACTURER="MyBot"
CONFIG_UAC_TUSB_SERIAL_NUM="MOSAICO-V12-UAC-TEST"
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_SPK_INTERVAL_MS=10
CONFIG_UAC_MIC_INTERVAL_MS=10
CONFIG_UAC_SPK_NEW_PLAY_INTERVAL=100
CONFIG_UAC_SPK_TASK_PRIORITY=6
CONFIG_UAC_SPK_TASK_CORE=0
CONFIG_UAC_MIC_TASK_PRIORITY=6
CONFIG_UAC_SUPPORT_MACOS=y
